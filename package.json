{
  "name": "agendafacil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:coverage:availability": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=src/modules/availability/availability-engine.js --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-skip-pattern=\"500 ms\" \"test/unit/availability-engine*.test.js\"",
    "perf": "node --test --test-concurrency=1 test/browser/public-page.perf.js test/browser/agenda.perf.js",
    "test:e2e": "node --test --test-concurrency=1 test/browser/public-page.e2e.js test/browser/booking.e2e.js test/browser/manage.e2e.js test/browser/email.e2e.js test/browser/agenda.e2e.js test/browser/timezone.e2e.js",
    "migrate": "node src/db/migrate.js",
    "lint": "eslint . --max-warnings 0",
    "smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "smtp-server": "^3.21.7"
  }
}
